<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.search.SearchFragment">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white_primary"
        android:elevation="8dp">

        <!-- Main Header Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp">

            <!-- Logo and Title Section -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Logo Container with Border -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="12dp">

                    <!-- Gradient Border Background -->
                    <View
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/logo_gradient_border" />

                    <!-- White Background Circle -->
                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:background="@drawable/logo_white_bg" />

                    <!-- Main Logo -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/go_news"
                        android:background="@drawable/logo_inner_gradient"
                        app:civ_border_width="0dp" />

                    <!-- Notification Dot -->
                    <View
                        android:id="@+id/notification_dot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/notification_dot"
                        android:visibility="visible" />

                </FrameLayout>

                <!-- Title and Subtitle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_app_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GoNews"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_blue"
                        android:fontFamily="@font/inter_bold"
                        android:letterSpacing="0.02"
                        android:shadowColor="@color/accent_purple"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2" />

                    <TextView
                        android:id="@+id/tv_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cari Berita"
                        android:textSize="13sp"
                        android:textColor="@color/subtitle_gray"
                        android:fontFamily="@font/inter_medium"
                        android:layout_marginTop="1dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Action Buttons Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Menu Button -->
                <ImageButton
                    android:id="@+id/btn_open_side_nav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/baseline_menu_24"
                    android:background="@drawable/circular_button_bg"
                    android:contentDescription="Open navigation drawer"
                    android:scaleType="centerInside"
                    android:padding="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Secondary Info Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- Live Status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/live_indicator"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live"
                        android:textSize="11sp"
                        android:textColor="@color/live_text"
                        android:fontFamily="@font/inter_medium" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_last_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update terakhir: 1 menit lalu"
                    android:textSize="11sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="@font/inter_regular" />

            </LinearLayout>

            <!-- News Counter -->
            <TextView
                android:id="@+id/tv_news_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10+ berita baru"
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                android:fontFamily="@font/inter_regular" />

        </LinearLayout>

        <!-- Bottom Accent Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/bottom_accent_gradient" />

    </LinearLayout>

    <!-- Search Input Section -->
    <LinearLayout
        android:id="@+id/search_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:orientation="horizontal"
        android:padding="20dp"
        android:background="@android:color/white"
        android:elevation="0dp"
        android:gravity="center_vertical">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/search_input_background"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/et_search_query"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/btn_search"
                android:hint="Cari berita terbaru..."
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:background="@android:color/transparent"
                android:textSize="16sp"
                android:textColor="#1F2937"
                android:textColorHint="#9CA3AF"
                android:fontFamily="sans-serif"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/search_button_background"
                android:src="@drawable/baseline_search_24"
                android:contentDescription="Search"
                android:scaleType="centerInside"
                app:tint="#6B7280" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_recent_searches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_input_layout"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="visible"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riwayat Pencarian Terbaru"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/ll_recent_search_chips_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:paddingTop="4dp"/>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_clear_recent_searches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus Riwayat"
            android:layout_gravity="end"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_medium"
            app:cornerRadius="20dp"
            app:backgroundTint="#FDE8E8"
            app:strokeColor="#F8B4B4"
            app:strokeWidth="1dp"
            app:rippleColor="#F3F4F6"
            android:textColor="#E02424"
            app:icon="@drawable/baseline_delete_24"
            app:iconTint="#E02424"
            app:iconPadding="2dp"
            app:iconGravity="textStart"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_recommended_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layout_recent_searches"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="visible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/chip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekomendasi untuk Anda"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_teknologi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teknologi"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kesehatan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kesehatan"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_olahraga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olahraga"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_politik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Politik"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_ekonomi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ekonomi"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_hiburan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hiburan"
                app:chipBackgroundColor="#F9FAFB"
                app:chipStrokeWidth="1dp"
                app:chipStrokeColor="#E5E7EB"
                style="@style/Widget.MaterialComponents.Chip.Action" />
        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>


    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_recommended_categories"> <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading_search"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loader_emoji" />

        <TextView
            android:id="@+id/tv_error_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone"
            android:text="Tidak ada hasil pencarian." />

    </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</RelativeLayout>