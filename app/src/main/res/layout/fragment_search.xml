<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.search.SearchFragment">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/go_news"
            android:contentDescription="Go News Logo"
            android:layout_marginEnd="8dp"
            app:civ_border_width="0dp"
            app:civ_border_color="#FFFFFF" />
        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pencarian Berita"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_500"
            android:gravity="center_horizontal" />

        <ImageButton
            android:id="@+id/btn_open_side_nav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/baseline_menu_24"
            android:background="@android:color/transparent"
            android:contentDescription="Open navigation drawer" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header_layout"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/white"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Cari berita..."
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:padding="12dp"
            android:background="@drawable/rounded_edittext_background" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_search_24"
            android:contentDescription="Search"
            app:tint="@color/purple_500" />

    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_input_layout"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_teknologi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teknologi"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_kesehatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kesehatan"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_olahraga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olahraga"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_politik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Politik"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_ekonomi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ekonomi"
            style="@style/Widget.MaterialComponents.Chip.Action" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hiburan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hiburan"
            style="@style/Widget.MaterialComponents.Chip.Action" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/chip_group_tags"> <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:clipToPadding="false" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading_search"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loader_emoji" />

        <TextView
            android:id="@+id/tv_error_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:visibility="gone"
            android:text="Tidak ada hasil pencarian." />

    </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</RelativeLayout>