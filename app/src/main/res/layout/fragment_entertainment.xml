<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.entertainment.EntertainmentFragment">

    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="8dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:layout_alignParentTop="true">

        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/point_news"
            android:contentDescription="Point News Logo"
            android:layout_marginEnd="8dp"
            app:civ_border_width="0dp"
            app:civ_border_color="#FFFFFF" />
        <TextView
            android:id="@+id/tv_page_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Berita Hiburan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_500"
            android:gravity="center_horizontal" />

        <ImageButton
            android:id="@+id/btn_open_side_nav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/baseline_menu_24"
            android:background="@android:color/transparent"
            android:contentDescription="Open navigation drawer" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_entertainment_news"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loading_entertainment"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loader_emoji" />
    <TextView
        android:id="@+id/tv_error_entertainment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@android:color/holo_red_dark"
        android:textStyle="bold"
        android:textSize="16sp"
        android:visibility="gone"
        android:text="Terjadi kesalahan saat memuat berita hiburan." />

</RelativeLayout>